          "_name": "features15",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features15\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Color\" name=\"iconColor\" value=\"#6592e6\" selected condition=\"showIcon\">\n        <select title=\"Columns\" name=\"columns\">\n            <option value=\"3\">4</option>\n            <option value=\"4\" selected>3</option>\n            <option value=\"6\">2</option>\n            <option value=\"12\">1</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <h4 class=\"mbr-section-title mbr-fonts-style mb-5\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\"><b>Đặc điểm nổi bật của nền tảng học tập LinkedIn Learning</b></h4>\n        <div class=\"row justify-content-center\">\n              <div class=\"item features-without-image col-12 col-md-4 active opt1\">\n                  <div class=\"item-wrapper py-4 px-2\">\n                      <span mbr-icon class=\"mbr-iconfont mobi-mbri-protect mobi-mbri m-auto\" mbr-if=\"showIcon\"></span>\n                      <div class=\"card-box\">\n                          <h4 class=\"card-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Định hướng</b></h4>\n                          <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">nhân viên nhận biết những kỹ năng thiết yếu giúp phát triển sự nghiệp và tạo ra giá trị bền vững cho doanh nghiệp.</h5>\n                      </div>\n                  </div>\n              </div>\n              <div class=\"d-flex align-items-center item features-without-image col-12 col-md-8 m-0 fxmr odesc1\">\n                  <div class=\"ms-3 circle-progress cirnum1 col-2\">\n                      <div class=\"circle-inner\">\n                          <span class=\"percentage1 mbr-fonts-style\" mbr-theme-style=\"display-5\">#1</span>\n                      </div>\n                  </div>\n                  <div class=\"item-wrapper\">\n                      <div class=\"card-box d-flex\">\n                          <h5 class=\"card-text mbr-fonts-style descript\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                              Đây chính là<b> lý do</b> <b>TOP #1</b> kích thích mọi người học tập để thăng tiến trong sự nghiệp<br>\n                          </h5>\n                      </div>\n                  </div>\n              </div>           \n        </div>\n        <div class=\"row justify-content-center\">\n              <div class=\"d-flex align-items-center item features-without-image col-12 col-md-8 fxmr odesc2\">\n                  \n                  <div class=\"item-wrapper\">\n                      <div class=\"card-box d-flex align-items-center\">                      \n                          <h5 class=\"text-end mbr-fonts-style descript\" mbr-theme-style=\"display-5\"><b>65%</b> kỹ năng hiện tại sẽ bị thay thế hoặc buộc phải cập nhật mới từ nay đến năm 2030</h5>\n                      </div>\n                  </div>\n                  <div class=\"me-3 circle-progress cirnum2 col-2\">\n                      <div class=\"circle-inner\">\n                          <span class=\"percentage2 mbr-fonts-style\" mbr-theme-style=\"display-5\">65%</span>\n                      </div>\n                  </div>\n              </div> \n              <div class=\"item features-without-image col-12 col-md-4 active opt2\">\n                  <div class=\"item-wrapper py-4 px-2\">\n                      <span mbr-icon class=\"mbr-iconfont mobi-mbri-protect mobi-mbri m-auto\" mbr-if=\"showIcon\"></span>\n                      <div class=\"card-box\">\n                          <h4 class=\"card-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Phát huy</b></h4>\n                          <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">các kỹ năng quan trọng, nội dung và phương thức đào tạo linh hoạt, phù hợp với sự thay đổi không ngừng của thị trường.</h5>\n                      </div>\n                  </div>\n              </div>                   \n        </div>\n        <div class=\"row justify-content-center\">\n              <div class=\"item features-without-image col-12 col-md-4 active opt3\">\n                  <div class=\"item-wrapper py-4 px-2\">\n                      <span mbr-icon class=\"mbr-iconfont mobi-mbri-protect mobi-mbri m-auto\" mbr-if=\"showIcon\"></span>\n                      <div class=\"card-box\">\n                          <h4 class=\"card-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Kết nối</b></h4>\n                          <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">kỹ năng đúng thời điểm, đúng phòng ban để thúc đẩy hiệu suất và gia tăng tác động trong doanh nghiệp của bạn.</h5>\n                      </div>\n                  </div>\n              </div>\n              <div class=\"d-flex align-items-center item features-without-image col-12 col-md-8 m-0 fxmr odesc3\">\n                  <div class=\"ms-3 circle-progress cirnum3 col-2\">\n                      <div class=\"circle-inner\">\n                          <span class=\"percentage3 mbr-fonts-style\" mbr-theme-style=\"display-5\">87%</span>\n                      </div>\n                  </div>\n                  <div class=\"item-wrapper\">\n                      <div class=\"card-box d-flex align-items-center\">                        \n                          <h5 class=\"card-text mbr-fonts-style descript\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\"><b>87%</b> các chuyên gia Đào tạo &amp; Phát triển (L&amp;D) cho rằng cải thiện kỹ năng nhân viên có thể tạo ra giá trị cho doanh nghiệp</h5>\n                      </div>\n                  </div>\n              </div>           \n        </div>\n         <div class=\"row justify-content-center rv\">\n              <div class=\"d-flex align-items-center item features-without-image col-12 col-md-8 fxmr odesc4\">                  \n                  <div class=\"item-wrapper\">\n                      <div class=\"card-box\">\n                          <h5 class=\"text-end mbr-fonts-style descript\" mbr-theme-style=\"display-5\">Việc giữ chân nhân viên tốt hơn <b>57%</b> nếu doanh nghiệp xây dựng tốt văn hóa học tập</h5>\n                      </div>\n                  </div>\n                  <div class=\"me-3 circle-progress cirnum4 col-2\">\n                      <div class=\"circle-inner\">\n                          <span class=\"percentage4 mbr-fonts-style\" mbr-theme-style=\"display-5\">57%</span>\n                      </div>\n                  </div>\n              </div> \n              <div class=\"item features-without-image col-12 col-md-4 active opt4\">\n                  <div class=\"item-wrapper py-4 px-2\">\n                      <span mbr-icon class=\"mbr-iconfont mobi-mbri-protect mobi-mbri m-auto\" mbr-if=\"showIcon\"></span>\n                      <div class=\"card-box\">\n                          <h4 class=\"card-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Đo lường</b></h4>\n                          <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">mức độ tác động của kỹ năng cần thiết lên các chiến lược ưu tiên của doanh nghiệp và phát triển sự nghiệp của nhân viên.</h5>\n                      </div>\n                  </div>\n              </div>                   \n        </div>\n        <div mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\" class=\"mbr-section-btn\"><a class=\"btn btn-success\" href=\"index.html#li-form\" data-app-placeholder=\"Type Text\">Đăng ký tư vấn</a></div>\n\n    </div>\n</section>",
