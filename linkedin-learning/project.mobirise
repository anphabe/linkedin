        "order": 1,
        "meta_descr": "Giải pháp LinkedIn Talent Solutions - Tuyển dụng những ứng viên phù hợp nhanh hơn với giải pháp tuyển dụng dễ dàng và thông tin chi tiết mạnh mẽ từ cộng đồng tích cực của LinkedIn.",
        "footer_custom": "",
        "header_custom": "<meta name=\"facebook-domain-verification\" content=\"eskryss5mu3nd6ii839t430680129i\" />\n",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/334581918-534976095288068-5154348048921760439-n.jpg"
      },
      "components": [
        {
